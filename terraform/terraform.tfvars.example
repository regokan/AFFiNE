# =============================================================================
# AFFiNE AWS Terraform - Example Variables
# =============================================================================
# Copy this file to terraform.tfvars and update the values
# cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

aws_region   = "us-east-1"
project_name = "affine"
environment  = "production"

# -----------------------------------------------------------------------------
# Network Security
# -----------------------------------------------------------------------------

# IMPORTANT: Restrict SSH access to your IP only!
# Find your IP at: https://whatismyip.com
# Format: "YOUR_IP/32" (e.g., "203.0.113.42/32")
allowed_ssh_cidr = "0.0.0.0/0" # WARNING: Change this!

# -----------------------------------------------------------------------------
# EC2
# -----------------------------------------------------------------------------

ec2_instance_type = "t3.small" # 2 vCPU, 2GB RAM (~$15/month)
ec2_volume_size   = 30         # GB

# Optional: Use existing key pair (leave empty to auto-generate)
ec2_key_name = ""

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

db_instance_class    = "db.t3.micro" # 2 vCPU, 1GB RAM (~$15/month)
db_allocated_storage = 20            # GB
db_backup_retention  = 7             # Days

db_username = "affine"
db_password = "CHANGE_THIS_SECURE_PASSWORD_123!" # CHANGE THIS!

# -----------------------------------------------------------------------------
# AFFiNE
# -----------------------------------------------------------------------------

# Docker image tag: "stable" or "canary"
affine_revision = "stable"

# -----------------------------------------------------------------------------
# Email (SES)
# -----------------------------------------------------------------------------

# Your domain for sending emails (optional)
# Leave empty to configure later
ses_domain = ""

# Sender email address (must be verified in SES)
mailer_sender = "AFFiNE <noreply@example.com>"

# -----------------------------------------------------------------------------
# Domain & SSL
# -----------------------------------------------------------------------------

# Your domain for AFFiNE (e.g., affine.example.com)
# Requires DNS A record pointing to EC2 IP
# Leave empty to skip HTTPS setup (access via IP:3010)
domain_name = ""

# Email for Let's Encrypt certificate notifications
ssl_email = ""

# -----------------------------------------------------------------------------
# AI/Copilot (optional)
# -----------------------------------------------------------------------------

# OpenAI API key for AFFiNE Copilot features
# Get from: https://platform.openai.com/api-keys
openai_api_key = ""
